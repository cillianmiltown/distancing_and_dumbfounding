{"SurveyEntry":{"SurveyID":"SV_cYDaf2iYLcuj2oS","SurveyName":"Dynamic Pie Chart","SurveyDescription":null,"SurveyOwnerID":"UR_bDdyAiavGwq8y1w","SurveyBrandID":"cornell","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_e2wCa2VNUNu8T30","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2025-12-15 19:35:56","CreatorID":"UR_bDdyAiavGwq8y1w","LastModified":"2025-12-18 08:52:11","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"1":{"Type":"Trash","Description":"Trash \/ Unused Questions","ID":"BL_73Ah7oHbCAzVmtg","BlockElements":[]},"29":{"Type":"Standard","SubType":"","Description":"Pie Chart Values","ID":"BL_ezGVHWCgOJwn0q2","BlockElements":[{"Type":"Question","QuestionID":"QID178"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Collapsed"}}}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"FL","PrimaryAttribute":"Survey Flow","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Type":"Root","FlowID":"FL_1","Flow":[{"Type":"EmbeddedData","FlowID":"FL_2","EmbeddedData":[{"Description":"fullText","Type":"Recipient","Field":"fullText","VariableType":"String","DataVisibility":[],"AnalyzeText":false}]},{"Type":"Branch","FlowID":"FL_4","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID42","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID42\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID42","LeftOperand":"q:\/\/QID42\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Consent Form\u200b\u200b\u200b\u200b\u200b\u200b What the study is aboutThis study examines a set of questions related to one\u2019s...<\/span> <span class=\"LeftOpDesc\">Consent not given<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"EndSurvey","FlowID":"FL_33","EndingType":"Advanced","Options":{"Advanced":"true","SurveyTermination":"DisplayMessage","EOSMessageLibrary":"UR_bDdyAiavGwq8y1w","EOSMessage":"MS_4ZdeR2lP1WrZtzw"}}]},{"Type":"Branch","FlowID":"FL_5","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID42","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID42\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID42","LeftOperand":"q:\/\/QID42\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Consent Form\u200b\u200b\u200b\u200b\u200b\u200b\n\n\n\tWhat the study is aboutThis study examines a set of questions related to one\u2019s mindset and perceptions of art.\n\t&amp;nbsp;\n\tWhat we will ask you to doThe initial survey will ask a...<\/span> <span class=\"LeftOpDesc\">Consent given<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"BlockRandomizer","FlowID":"FL_10","SubSet":2,"EvenPresentation":true,"Flow":[{"Type":"Group","FlowID":"FL_14","Description":"Individual Differences Measures","Flow":[{"Type":"BlockRandomizer","FlowID":"FL_28","SubSet":1,"EvenPresentation":true,"Flow":[{"Type":"Group","FlowID":"FL_30","Description":"Wylie Measures","Flow":[{"Type":"Standard","ID":"BL_ezGVHWCgOJwn0q2","FlowID":"FL_31","Autofill":[]}]}]}]},{"Type":"Group","FlowID":"FL_15","Description":"Main Study","Flow":[{"Type":"BlockRandomizer","FlowID":"FL_17","SubSet":0,"EvenPresentation":true,"Flow":[]},{"Type":"BlockRandomizer","FlowID":"FL_18","SubSet":0,"EvenPresentation":true,"Flow":[]}]}]},{"Type":"EndSurvey","FlowID":"FL_6","EndingType":"Default","Options":{"Advanced":"","SurveyTermination":"Redirect","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=CDC4TVUF"}}]}],"Properties":{"Count":33}}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_00qyOqTim5dIaAC","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"I would change this to \"Please rate how moral this artist's behavior was.\" And I would put it on its own page. It's a little unclear whether this Q refers to the immoral behavior in the previous Q. But I think that's OK.","ID":"NO_ehsJIQ8KExupHzU","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486126,"Removed":true},{"Message":"On all of these sliders, why do they end in 50, when they have a max of 100?","ID":"NO_56DAqFY9zFw9Pnw","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486359,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID21","ID":"NT_00qyOqTim5dIaAC"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_0SrKuROFdKUkt8i","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"I think you might want to add \"recently\" before listen. It is not clear here that you are referring to the listening episode asked about it the first Q. Also, this Q being on its own page it good because it makes it less likely people will directly compare their response to the previous Q: i.e., \"how bad is artist\" + \"how bad am I\".","ID":"NO_9MLRipkUS7PQeZE","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486303,"Removed":false}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded"},"ParentID":"QID22","ID":"NT_0SrKuROFdKUkt8i"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_5A20XxWa93qdDro","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"If this is referring to supporting the artist despite controversy, that needs to be made clear. \"Despite this artist's behaviors, how much do you support this artist?\"","ID":"NO_3awPnZ4wEY5U8Wq","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486593,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID31","ID":"NT_5A20XxWa93qdDro"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_6hP2RF1CaPT4oTQ","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"Remove \"50\" anchor and add Midpoint \"Not at all\"","ID":"NO_6say23ZoRcIMFUy","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486662,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID30","ID":"NT_6hP2RF1CaPT4oTQ"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_6KHo5TGAR0ctYX4","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"What about making this more clear by asking people \"Now, how moral would a random stranger think it was for you to listen to this artist's music?\"","ID":"NO_01mbnZ11dPiCzae","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700485971,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID23","ID":"NT_6KHo5TGAR0ctYX4"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_6yddHPEhcZNTxHM","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"Add in bold italics \"as a person\" after artist.","ID":"NO_07yreFq0LtPQHoG","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486413,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID24","ID":"NT_6yddHPEhcZNTxHM"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_d5dOb1gqXAIJxpI","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"Demographics? Brief debrief?","ID":"NO_dht11j3jKDZc3rM","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700487158,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID14","ID":"NT_d5dOb1gqXAIJxpI"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_ebvITHrYuORDYkS","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"Why not use the Inclusion of the Other in the Self (IOS) scale - adapted for artist\/art? Ivy's senior thesis student Annika used it last Spring this way. They pick a number from 1-7, each representing increasing overlapping circles. It is from Aron, Aron, Smollan, 1992 https:\/\/doi.org\/10.1037\/0022-3514.63.4.596","ID":"NO_3lsfjazgXK6DTKK","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486935,"Removed":true},{"Message":"Added below, in new Q","ID":"NO_emV5gMlEPkf7rZI","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700487089,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID10","ID":"NT_ebvITHrYuORDYkS"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"NT","PrimaryAttribute":"NT_efh6gHyRbsRIDRQ","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"Reason for this order? Music, then artist as a person makes better sense to me.","ID":"NO_6rqRqXKKxaiwlEO","UserID":"UR_74i4GyUaEeLcTlz","Timestamp":1700486459,"Removed":true}],"UserStatuses":{"UR_74i4GyUaEeLcTlz":"Expanded","UR_bDdyAiavGwq8y1w":"Expanded"},"ParentID":"QID25","ID":"NT_efh6gHyRbsRIDRQ"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"9390cb9b-0832-4c53-8215-91b9a36d2ac1"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"180","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"RS","PrimaryAttribute":"RS_e2wCa2VNUNu8T30","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"cornell","SkinType":"MQ","Skin":"skin7_update","NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","headerMid":"","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"true","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=CDC4TVUF","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"PageTransition":"fade","Autofocus":false,"nextButtonLid":"","nextButtonMid":"","Autoadvance":false,"AutoadvancePages":false,"QuestionsPerPage":"","CustomStyles":{"customCSS":""}}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"SQ","PrimaryAttribute":"QID178","SecondaryAttribute":"We have one more question for you! Imagine a circle representing all the time in your life. Your...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">We have one more question for you!<br>\n<br>\nImagine a circle representing all the time in your life. Your task is to decide how much of that time you would ideally want to spend on different pursuits.<br>\n<br>\nThese pursuits include:<\/span>\n<ul>\n\t<li><span style=\"font-size:16px;\"><strong>Aesthetic &amp; Intellectual Expression<\/strong><\/span><br>\n\t<span style=\"font-size:16px;\">Pursuing and passing on knowledge, making and seeing art, seeking truth, playing or listening to music, perfecting a sport<\/span><br>\n\t&nbsp;<\/li>\n\t<li><span style=\"font-size:16px;\"><strong>Civic Life<\/strong> <\/span><br>\n\t<span style=\"font-size:16px;\">Pursuing political action, participating in collective decision-making, managing shared resources, engaging with your political community<\/span><br>\n\t&nbsp;<\/li>\n\t<li><span style=\"font-size:16px;\"><strong>Morality<\/strong><\/span><br>\n\t<span style=\"font-size:16px;\">Pursuing justice, promoting fairness, protecting others from risks and threats, participating in religious or spiritual practices<\/span><br>\n\t&nbsp;<\/li>\n\t<li><span style=\"font-size:16px;\"><strong>Play &amp; Leisure<\/strong><\/span><br>\n\t<span style=\"font-size:16px;\">Pursuing enjoyment for its own sake, engaging in play, having hobbies and recreational activities, taking time for leisure<\/span><br>\n\t&nbsp;<\/li>\n\t<li><span style=\"font-size:16px;\"><span style=\"font-size:16px;\"><strong>Relationships<\/strong><\/span><\/span><br>\n\t<span style=\"font-size:16px;\"><span style=\"font-size:16px;\">Pursuing connection and interaction with other people and animals, feeling close to others, maintaining ties with friends and family<\/span><\/span><\/li>\n<\/ul>\n<br><span style=\"font-size:16px;\"><span style=\"font-size:16px;\">Once you begin entering values, a pie chart will appear. Adjust the amounts for each pursuit so the chart reflects your ideal way of dividing your life across these pursuits.&nbsp;Your task is to adjust the pursuits you are shown to match YOUR ideal.<\/span><\/span>\n\n<div id=\"body-area\">&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"pie_chart","QuestionID":"QID178","QuestionType":"CS","Selector":"VRTL","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100},"QuestionDescription":"We have one more question for you! Imagine a circle representing all the time in your life. Your...","Choices":{"1":{"Display":"<strong>Aesthetic &amp; Intellectual Expression<\/strong><br \/>Pursuing and passing on knowledge, making and seeing art, seeking truth, playing or listening to music, perfecting a sport"},"2":{"Display":"<strong>Civic Life<\/strong><br \/>Pursuing political action, participating in collective decision-making, managing shared resources, engaging with your political community"},"3":{"Display":"<strong>Morality<\/strong><br \/>Pursuing justice, promoting fairness, protecting others from risks and threats, participating in religious or spiritual practices"},"4":{"Display":"<strong>Play &amp; Leisure<\/strong><br \/>Pursuing enjoyment for its own sake, engaging in play, having hobbies and recreational activities, taking time for leisure"},"5":{"Display":"<strong>Relationships<\/strong><br \/>Pursuing connection and interaction with other people and animals, feeling close to others, maintaining ties with friends and family"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"EnforceRange":"OFF","Type":"ChoicesTotal","ForceResponse":"OFF","ChoiceTotal":"100"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"Labels":[],"ClarifyingSymbolType":"Before","ClarifyingSymbol":"%","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\t\n\tconst totalLabel = document.querySelector('label[for=\"QID178_Total\"]');\n\ttotalLabel.innerHTML = '<span>Total <strong>(please enter values that add up to 100%)<\/strong><\/span>';\n\n\t\/\/ Load Plotly if not already loaded\n\tif (!window.Plotly) {\n\t\tconst script = document.createElement('script');\n\t\tscript.src = \"https:\/\/cdn.jsdelivr.net\/npm\/plotly.js-dist-min@2.24.0\";\n\t\tdocument.head.appendChild(script);\n\n\t\tscript.onload = function () {\n\t\t\twaitForElementAndInitialize(); \/\/ Initialize after Plotly and DOM target are ready\n\t\t};\n\t} else {\n\t\twaitForElementAndInitialize(); \/\/ Initialize immediately if Plotly is already loaded\n\t}\n\n\tfunction waitForElementAndInitialize() {\n\t\tconst targetId = 'Questions';\n\t\tconst targetElement = document.getElementById(targetId);\n\n\t\tif (targetElement) {\n\t\t\tconsole.log(\"noice\");\n\t\t\tsetTimeout(function () {\n\t\t\t\tinitialize(); \/\/ Force initialization after a delay\n\t\t\t}, 1000); \/\/ Adjust delay as necessary\n\t\t} else {\n\t\t\t\/\/ Use MutationObserver to wait for the element to appear\n\t\t\tconst observer = new MutationObserver((mutationsList, observer) => {\n\t\t\t\tconst observedElement = document.getElementById(targetId);\n\t\t\t\tif (observedElement) {\n\t\t\t\t\tconsole.log(\"bruh\");\n\t\t\t\t\tobserver.disconnect(); \/\/ Stop observing once the element is found\n\t\t\t\t\tinitialize(); \/\/ Initialize the chart and constraints\n\t\t\t\t}\n\t\t\t});\n\n\t\t\t\/\/ Start observing the document body for changes\n\t\t\tobserver.observe(document.body, { childList: true, subtree: true });\n\t\t}\n\t}\n\n\tfunction initialize() {\n\t\tenforceInputConstraints();\n\t\tcreatePieChart();\n\t}\n\n\tfunction enforceInputConstraints() {\n\t\tconst inputs = document.querySelectorAll('input[type=\"text\"]');\n\n\t\tinputs.forEach(input => {\n\t\t\tinput.addEventListener('input', function () {\n\t\t\t\tlet value = input.value.replace(\/\\D\/g, ''); \/\/ Remove non-digit characters\n\t\t\t\tvalue = Math.min(Math.max(parseInt(value, 10) || 0, 0), 100); \/\/ Enforce 0-100 range\n\t\t\t\tinput.value = value; \/\/ Update the input field\n\t\t\t});\n\n\t\t\tinput.addEventListener('keydown', function (event) {\n\t\t\t\tconst allowedKeys = ['Backspace', 'Tab', 'ArrowLeft', 'ArrowRight', 'Delete'];\n\t\t\t\tconst isNumberKey = event.key >= '0' && event.key <= '9';\n\t\t\t\tif (!isNumberKey && !allowedKeys.includes(event.key)) {\n\t\t\t\t\tevent.preventDefault();\n\t\t\t\t}\n\t\t\t});\n\t\t});\n\t}\n\n\tfunction createPieChart() {\n\t\tconst idToLabelMap = {\n\t\t\t'QR~QID178~1': 'Aesthetic & Intellectual',\n\t\t\t'QR~QID178~2': 'Civic Life',\n\t\t\t'QR~QID178~3': 'Morality',\n\t\t\t'QR~QID178~4': 'Play & Leisure',\n\t\t\t'QR~QID178~5': 'Relationships'\n\t\t};\n\n\t\tconst layout = {\n\t\t\tshowlegend: true,\n\t\t\tfont: { family: \"Roboto, Arial, sans-serif\", size: 14 }\n\t\t};\n\n\t\tconst config = { displaylogo: false };\n\n\t\tconst pieChart = document.createElement('div');\n\t\tpieChart.id = 'dynamic-pie-chart';\n\t\tdocument.getElementById('Questions').appendChild(pieChart);\n\n\t\t\/\/ Initialize empty chart\n\t\tPlotly.newPlot(pieChart, getPieData([], []), layout, config);\n\n\t\t\/\/ Attach input event listeners to update the chart\n\t\tconst inputs = document.querySelectorAll('input[type=\"text\"]');\n\t\tinputs.forEach(input => {\n\t\t\tinput.addEventListener('input', updateChart);\n\t\t});\n\n\t\tfunction updateChart() {\n\t\t\tconst updatedValues = [];\n\t\t\tconst updatedLabels = [];\n\n\t\t\t\/\/ Gather valid values and labels\n\t\t\tObject.keys(idToLabelMap).forEach(id => {\n\t\t\t\tconst inputElement = document.getElementById(id);\n\t\t\t\tif (inputElement) {\n\t\t\t\t\tconst value = parseFloat(inputElement.value) || 0;\n\t\t\t\t\tif (value > 0) {\n\t\t\t\t\t\tupdatedValues.push(value);\n\t\t\t\t\t\tupdatedLabels.push(idToLabelMap[id]);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t});\n\n\t\t\t\/\/ Update chart only if total equals 100\n\t\t\tconst total = updatedValues.reduce((a, b) => a + b, 0);\n\t\t\tconst pieData = total === 100 ? getPieData(updatedValues, updatedLabels) : getPieData([], []);\n\t\t\tPlotly.react(pieChart, pieData, layout, config);\n\t\t}\n\n\t\tfunction getPieData(values, labels) {\n\t\t\treturn [{\n\t\t\t\tvalues: values,\n\t\t\t\tlabels: labels,\n\t\t\t\ttype: 'pie',\n\t\t\t\ttextinfo: 'percent',\n\t\t\t\ttextfont: { size: 16 },\n\t\t\t\thoverinfo: 'label+percent',\n\t\t\t\toutsidetextfont: { size: 16 }\n\t\t\t}];\n\t\t}\n\t}\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\t\/* Place your JavaScript here to run when the page is fully displayed *\/\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n\t\/* Place your JavaScript here to run when the page is unloaded *\/\n});","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_cYDaf2iYLcuj2oS","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}